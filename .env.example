# =============================================================================
# Cuprichem — SINGLE source of environment configuration.
#
# This is the ONE env file for the whole repository: the public Next.js site
# (root), the admin Next.js console (admin/) and the Django API (backend/) all
# read it. There is no per-app .env — adding one would reintroduce the drift
# this file exists to prevent.
#
#   cp .env.example .env      # then fill in per environment
#
# Loading:
#   * public site  — Next loads ./.env automatically (repo root is its root).
#   * admin        — admin/next.config.ts calls loadEnvConfig() on the repo root
#                    and inlines the browser-visible keys via `env`.
#   * backend      — backend/config/settings/base.py load_dotenv()s this file.
#
# NEVER commit the real .env. Only this example is tracked.
#
# Anything listed under "browser-visible" below is compiled into the JavaScript
# bundle and is public. No secret may ever be added to those sections.
# =============================================================================


# -----------------------------------------------------------------------------
# Site identity  (browser-visible)
# -----------------------------------------------------------------------------
SITE_NAME=Cuprichem
SITE_LEGAL_NAME=Cuprichem Industrial Chemicals Ltd
SITE_TAGLINE=Industrial chemicals, specified and sourced.
SITE_DESCRIPTION=Cuprichem Industrial Chemicals Ltd is a Nairobi-based supplier of industrial chemicals, serving manufacturers, institutions and technical buyers across Kenya.
# Canonical public origin, no trailing slash. Drives canonical URLs, sitemap,
# robots, Open Graph absolute URLs and the backend's revalidation hooks.
SITE_URL=https://www.cuprichem.co.ke
SITE_LOCALE=en_KE
SITE_LANGUAGE=en
# Short headline printed on the generated Open Graph card.
SITE_OG_HEADLINE=Source industrial chemicals with technical precision.
# Ordered process labels shown on the OG card footer.
SITE_PROCESS_STEPS=Discover,Specify,Source


# -----------------------------------------------------------------------------
# Company facts  (browser-visible)
#
# Taken verbatim from client documentation. The KRA PIN and the named director
# are deliberately absent — sensitive identity data that no buyer needs. Do not
# add them here; anything in this section reaches the browser.
# -----------------------------------------------------------------------------
COMPANY_EMAIL=cuprichemindustrialchemicals@gmail.com
COMPANY_SALES_EMAIL=salescuprichemindustrialchemic@gmail.com
# Comma-separated list of `display|E.164` pairs. The first is the primary number
# used for the header, the click-to-call button and Organization JSON-LD.
COMPANY_PHONES=0721 856 061|+254721856061,0111 314 860|+254111314860,0736 672 323|+254736672323
# E.164 number (digits only, no +) backing the WhatsApp deep link.
COMPANY_WHATSAPP=254721856061
COMPANY_ADDRESS_BUILDING=Repen/Repem Complex Bld, 2nd Floor
COMPANY_ADDRESS_STREET=Katani Road
COMPANY_ADDRESS_LOCALITY=Syokimau
COMPANY_ADDRESS_REGION=Nairobi
COMPANY_ADDRESS_COUNTRY=Kenya
COMPANY_ADDRESS_COUNTRY_CODE=KE
COMPANY_POSTAL_ADDRESS=P.O. Box 18648-00100, Nairobi


# -----------------------------------------------------------------------------
# Brand assets and runtime colours  (browser-visible)
#
# These are the colours consumed by JavaScript at runtime (PWA manifest, mobile
# browser chrome, the generated OG card). The full design-token palette lives in
# src/app/globals.css; keep these in step with it.
#
# Hex values are quoted: an unquoted `#` starts a comment in a .env file.
# -----------------------------------------------------------------------------
BRAND_LOGO_PATH=/brand/cuprichem-logo.png
BRAND_LOGO_WIDTH=247
BRAND_LOGO_HEIGHT=140
BRAND_ICON_PATH=/icon.png
BRAND_APPLE_ICON_PATH=/apple-icon.png
BRAND_COLOR_HEADER="#0b3f68"
BRAND_COLOR_INK="#0e2033"
BRAND_COLOR_PAPER="#fbfaf7"
BRAND_COLOR_ACCENT="#7cc142"
BRAND_COLOR_MUTED="#93a3b4"


# -----------------------------------------------------------------------------
# Origins and ports
# -----------------------------------------------------------------------------
# Public site dev server.
WEB_PORT=3000
# Admin console. Its origin MUST share a host with API_BASE_URL (ports may
# differ): the auth cookie is SameSite=Lax, which is decided by host, not port.
# localhost:3001 -> localhost:8000 works; localhost:3001 -> 127.0.0.1:8000 is
# cross-site and the browser drops the cookie on every request.
ADMIN_PORT=3001
ADMIN_ORIGIN=http://localhost:3001
ADMIN_APP_NAME=Cuprichem Control Centre
ADMIN_APP_DESCRIPTION=Internal control centre for the Cuprichem catalogue and website.

# Django REST API origin  (browser-visible — the admin calls it directly).
API_BASE_URL=http://localhost:8000

# Remote image/CDN origin allowed by both apps' CSP and next/image. Blank
# disables remote images entirely.
MEDIA_CDN_ORIGIN=https://res.cloudinary.com


# -----------------------------------------------------------------------------
# Django core  (server-side)
# -----------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LANGUAGE_CODE=en-gb
DJANGO_TIME_ZONE=Africa/Nairobi
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# Database  (server-side)
# -----------------------------------------------------------------------------
POSTGRES_DB=cuprichem
POSTGRES_USER=cuprichem
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_TEST_DB=test_cuprichem


# -----------------------------------------------------------------------------
# Auth cookies  (server-side)
# -----------------------------------------------------------------------------
# Must be 1 in production. 0 only for local plain-HTTP development.
JWT_COOKIE_SECURE=0
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_DOMAIN=
JWT_ALGORITHM=HS256
JWT_ACCESS_COOKIE=cuprichem_access
JWT_REFRESH_COOKIE=cuprichem_refresh
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800


# -----------------------------------------------------------------------------
# OpenAI  (server-side ONLY)
#
# This key must never appear in a browser-visible variable. Leave blank to run
# with AI features reporting "not configured" rather than simulating results.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_VISION_MODEL=
OPENAI_TIMEOUT=90
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=4000


# -----------------------------------------------------------------------------
# Cloudinary  (server-side ONLY — the admin never talks to Cloudinary directly)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cuprichem


# -----------------------------------------------------------------------------
# Revalidation  (server-side)
# -----------------------------------------------------------------------------
# Shared secret the backend sends as X-Revalidate-Secret when content changes.
REVALIDATE_SECRET=


# -----------------------------------------------------------------------------
# Background jobs  (server-side)
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=0
CELERY_TASK_TIME_LIMIT=600


# -----------------------------------------------------------------------------
# Limits  (server-side). AI calls cost money — keep these conservative.
# -----------------------------------------------------------------------------
THROTTLE_AI_GENERATE=20/hour
THROTTLE_AI_ANALYZE=30/hour
THROTTLE_SEO_AUDIT=60/hour
THROTTLE_LOGIN=10/min
API_PAGE_SIZE=25
MAX_UPLOAD_BYTES=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/avif


# -----------------------------------------------------------------------------
# Deployment  (docker compose + Caddy)
# -----------------------------------------------------------------------------
# Hostname Caddy serves and obtains a certificate for.
SITE_ADDRESS=cuprichem.co.ke
