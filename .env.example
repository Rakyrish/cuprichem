# Copy to .env.local and fill in per environment. Never commit real secrets.

# Canonical public origin (no trailing slash). Drives canonical URLs, sitemap,
# robots and Open Graph absolute URLs.
NEXT_PUBLIC_SITE_URL=https://www.cuprichem.co.ke

# Cloudinary (Phase: images). Custom loader only; leave unset until configured.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Phase 2 — Django REST API base URL. The frontend consumes catalogue content
# through lib/content.ts; until this is set, content is read from local files.
NEXT_PUBLIC_API_BASE_URL=
